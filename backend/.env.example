# ==========================================================================
# Copy this file to `.env` (already git-ignored) and fill in real values.
# Never commit a file containing real credentials.
#
# How you load these into the JVM is up to you, e.g.:
#   - export them in your shell before `mvn spring-boot:run`
#   - use an IDE run-configuration "environment variables" panel
#   - use a tool like `direnv` or `dotenv-java` locally
#   - set them as real environment variables / secrets on your server or
#     hosting platform (Docker, systemd, Render, Railway, etc.) in production
# ==========================================================================

SERVER_PORT=8080

# ---------- Database ----------
DB_URL=jdbc:mysql://localhost:3306/shree_associates?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=Tanvi9903@
DDL_AUTO=update

# ---------- WhatsApp Business Cloud API ----------
# Get these from https://developers.facebook.com/apps -> your app -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The Shree Associates number that should RECEIVE enquiry notifications, E.164 without '+', e.g. 91XXXXXXXXXX
WHATSAPP_RECIPIENT_NUMBER=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_TEMPLATE_NAME=website_enquiry_notification
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_USE_TEMPLATE=true

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ---------- Rate limiting ----------
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
